#!/usr/bin/env zsh
# git look: zeigt, ob es Updates vom Remote gibt (Dry-Run für git pull).
# Git ruft dieses Skript bei "git look" automatisch auf, weil es im PATH liegt.
#   im Repo   -> prüft nur dieses Repo
#   außerhalb -> prüft alle Repos in ~/Git

local -a repos
local r n

if git rev-parse --is-inside-work-tree &>/dev/null; then
  repos=("$(git rev-parse --show-toplevel)")
else
  repos=(~/Git/*/.git(N:h))
fi

for r in $repos; do
  git -C "$r" fetch -q 2>/dev/null
  n=$(git -C "$r" rev-list --count HEAD..@{u} 2>/dev/null)
  if [[ -z "$n" ]]; then
    print -P "%F{yellow}${r:t}%f: kein Upstream"
  elif (( n > 0 )); then
    print -P "%F{red}${r:t}%f: $n neue Commits"
    git -C "$r" log --oneline HEAD..@{u} | sed 's/^/    /'
  else
    print -P "%F{green}${r:t}%f: aktuell"
  fi
done
