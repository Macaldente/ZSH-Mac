# Files stow must not link into $HOME. Overrides stow's built-in default list,
# so the defaults are repeated here.
\.git
\.gitignore
\.gitmodules
\.stow-local-ignore
\.DS_Store
.+~
\#.*\#
^/README.*
^/LICENSE.*
^/COPYING

# Documentation
^/ATUIN\.md
^/ZSH-AUTOCOMPLETE\.md

# Generated by antidote, which replaces the file with `mv -f` on rebuild and
# would turn a symlink back into a regular file.
\.zsh_plugins\.zsh
